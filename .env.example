# Copy to .env and fill in. Never commit .env.
# Twilio (b-sms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Exact public tunnel base URL, used for Twilio signature validation (b-sms)
PUBLIC_BASE_URL=
# Enrolled phones, E.164 (b-consent-storage)
DEMO_PHONE=
SPARE_PHONE=
# Salt for SHA-256 of phone numbers (b-consent-storage)
CONSENT_SALT=
# Operator console login (b-api)
OPERATOR_PASSWORD=
SESSION_SECRET=
