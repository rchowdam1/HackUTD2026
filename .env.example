# Copy to .env and fill in. Never commit .env.
# Photon messaging for real SMS mode (b-photon, docs/photon-live.md)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Our line's agent user id (pho_usr_...)
PHOTON_SENDER_ID=
# imessage (default) or sms (sms needs an approved US 10DLC campaign)
PHOTON_PLATFORM=
# Webhook destination signing secret (whsec_...) and its id (demo_up repoints it at the tunnel)
PHOTON_WEBHOOK_SECRET=
PHOTON_WEBHOOK_ID=
# Exact public tunnel base URL; the Photon webhook destination is PUBLIC_BASE_URL/sms/inbound
# scripts/demo_up rewrites it for a quick tunnel; set it by hand for a named tunnel
PUBLIC_BASE_URL=
# Named cloudflared tunnel; empty = quick trycloudflare.com tunnel (b-twilio-live)
CLOUDFLARED_TUNNEL=
# Enrolled phones, E.164 (b-consent-storage)
DEMO_PHONE=
SPARE_PHONE=
# Salt for SHA-256 of phone numbers (b-consent-storage)
CONSENT_SALT=
# Replay source for demo runs: asr or cached (Track A ingest, default cached)
REPLAY_SOURCE=
# Operator console login (b-api)
OPERATOR_PASSWORD=
SESSION_SECRET=
