# Copy to .env and fill in. Never commit .env.
# Twilio for real SMS mode (b-sms, docs/twilio-live.md)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Twilio CLI profile `make demo` points the number's webhooks with (empty = Ameya)
TWILIO_CLI_PROFILE=
# Exact public tunnel base URL; Twilio signatures are validated against it (b-sms)
# scripts/demo_up rewrites it for a quick tunnel; set it by hand for a named tunnel
PUBLIC_BASE_URL=
# Named cloudflared tunnel; empty = quick trycloudflare.com tunnel (b-twilio-live)
CLOUDFLARED_TUNNEL=
# Enrolled phones, E.164 (b-consent-storage)
DEMO_PHONE=
SPARE_PHONE=
# HMAC key for stored phone hashes (b-consent-storage). Keep it out of any backup or copy of data/.
CONSENT_SALT=
# Replay source for demo runs: asr or cached (Track A ingest, default cached)
REPLAY_SOURCE=
# Operator console login (b-api)
# Use a long random password: the console is localhost-only (the tunnel only reaches /sms/inbound, /sms/status
# and /health), and /login returns 429 after 5 failures in 5 minutes.
OPERATOR_PASSWORD=
SESSION_SECRET=
# Arm C: on = each caller turn plus up to 3 turns before it is sent to Perplexity Decider V1.2 through OpenRouter
# (openrouter.ai). Leave off for real calls.
INTENT_MODEL=
OPENROUTER_API_KEY=
# on = serve /docs, /redoc, /openapi.json (local development only)
API_DOCS=
