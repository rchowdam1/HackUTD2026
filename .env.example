# Copy to .env and fill in. Never commit .env.
# Photon Spectrum iMessage for real SMS mode (b-photon, docs/photon-live.md). PROJECT_ID / PROJECT_SECRET
# live in hackutd/.env (written by create-spectrum-project). Shared secret between backend and bridge:
PHOTON_BRIDGE_TOKEN=
# Bridge URL; empty = http://127.0.0.1:8787
PHOTON_BRIDGE_URL=
# Our Photon line, E.164; the bridge pins sends to it (local .env only, never commit it)
PHOTON_LINE=
# Enrolled phones, E.164 (b-consent-storage)
DEMO_PHONE=
SPARE_PHONE=
# HMAC key for stored phone hashes (b-consent-storage). Keep it out of any backup or copy of data/.
CONSENT_SALT=
# Replay source for demo runs: asr or cached (Track A ingest, default cached)
REPLAY_SOURCE=
# Operator console login (b-api)
# Use a long random password: the console is localhost-only, and /login locks out after 5 failures.
OPERATOR_PASSWORD=
SESSION_SECRET=
# Arm C: on = caller turns plus the 3 turns before them are sent to api.typesafe.ai. Leave off for real calls.
INTENT_MODEL=
TYPESAFE_API_KEY=
# on = serve /docs, /redoc, /openapi.json (local development only)
API_DOCS=
