#!/usr/bin/env bash
# Preflight before every judging block (PRD §19.7): models cached + app starts offline, cached replay,
# tunnel + Twilio webhook, both phones opted in, one real test SMS. Usage: scripts/preflight [--no-sms]
cd "$(dirname "$0")/.." || exit 1
exec env -u PYTHONPATH -u PYTHONHOME -u VIRTUAL_ENV uv run python scripts/preflight_checks.py "$@"
