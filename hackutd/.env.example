# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=
# Shared secret with the CallSafe backend (root .env); scripts/demo_up passes it through
PHOTON_BRIDGE_TOKEN=
# Optional: backend URL (default http://127.0.0.1:8000) and bridge port (default 8787)
BACKEND_URL=
BRIDGE_PORT=
